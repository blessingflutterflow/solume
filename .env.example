# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/solune

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── AWS ─────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIA_replace_me
AWS_SECRET_ACCESS_KEY=replace_me
AWS_REGION=af-south-1

# ─── Admin auth ──────────────────────────────────────────────────────────────
ADMIN_EMAIL=blessing@solune.co.za
ADMIN_PASSWORD=set_a_strong_password_here

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_random_64_char_string
JWT_EXPIRY=7d

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_replace_me
FROM_EMAIL=hello@solune.co.za

# ─── Paystack ────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_PUBLIC_KEY=pk_test_replace_me

# ─── Platform ────────────────────────────────────────────────────────────────
PLATFORM_DOMAIN=solune.co.za
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
